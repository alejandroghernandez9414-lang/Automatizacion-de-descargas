
# --- Plataforma de ordenes (descargar_y_generar_bases.py) ---
WTM_BASE_URL=https://plataforma.ejemplo.com
WTM_USUARIO=
WTM_CLAVE=
# El valor que va despues de "Report?id=" en la URL de cada reporte
WTM_REPORT_ID_DC00=
WTM_REPORT_ID_RC00=
WTM_REPORT_ID_ZVCL=
# El atributo data-id del boton de exportar de cada reporte
WTM_EXPORT_ID_DC00=
WTM_EXPORT_ID_RC00=
WTM_EXPORT_ID_ZVCL=
# Carpetas de trabajo
CARPETA_BD_WTM=C:\ruta\a\BD_WTM
CARPETA_SESAP=C:\ruta\a\BD_SESAP
RUTA_SALIDA=C:\ruta\a\BASES_PSR.xlsx

# --- Power BI (descargar_reportes_powerbi.py) ---
# URL completa del reporte embebido (reportEmbed?reportId=...&ctid=...)
POWERBI_REPORT_URL=
# Nombre de la tabla del modelo de datos que se exporta
POWERBI_TABLA_EXPORTAR=
# Carpeta de destino de los reportes; usar ruta UNC si es una unidad de red
POWERBI_OUTPUT_DIR=\\servidor\carpeta\descargas
# Opcional: solo si Brave esta instalado en otra ruta
BRAVE_EXECUTABLE_PATH=
